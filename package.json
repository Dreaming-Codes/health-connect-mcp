{
  "name": "health-connect-mcp",
  "version": "0.7.0",
  "private": true,
  "description": "Android Connect: an MCP server on Cloudflare Workers that reaches your Android phone through FCM",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/sim-phone.mjs",
    "test:methods": "node test/methods.mjs",
    "test:contract": "bash test/with-worker.sh test/contract.mjs",
    "docs:tools": "bash test/with-worker.sh scripts/tools-reference.mjs > docs/reference/tools.md",
    "bundle": "wrangler deploy --dry-run --minify --outdir dist/worker"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}
